{
  "name": "park3d-rpc-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Park3D JSON-RPC(13510) -> MCP bridge",
  "type": "module",
  "bin": {
    "park3d-rpc-mcp": "dist/server.js"
  },
  "scripts": {
