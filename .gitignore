# ============================================================
# Park3D git 저장소 .gitignore
# - git 작업트리는 이 폴더(Parking), .git 메타데이터는 SVN 밖(D:\Work\GitRepos\Parking.git)
# - Content 등 대용량 바이너리는 SVN이 authoritative → git 제외
# ============================================================

# ===== Unreal Engine 생성물 (Park3D/) =====
Park3D/Binaries/
# 패키징(UAT BuildCookRun) 산출물 — 수 GB, SVN/재생성 대상
/Package/

# Python(_workspace 스크립트 등) 캐시
__pycache__/
*.pyc

# Node 의존성(park3d-rpc-mcp 브리지 등) — package.json 으로 재설치
node_modules/
Park3D/Intermediate/
Park3D/DerivedDataCache/
Park3D/Saved/
Park3D/.vs/
Park3D/*.sln
Park3D/*.slnx
Park3D/*.VC.db
Park3D/*.opensdf
Park3D/*.sdf

# ===== 대용량 바이너리 에셋 (SVN이 버전 관리) =====
# Content(.uasset/.umap)는 수 GB 바이너리 → git 제외. 에셋 이력은 SVN에서 관리.
Park3D/Content/

# 사용하지 않는 콘텐츠를 분리해 둔 폴더(2026-08-16). UE 는 Content 만 스캔하므로 여기 있으면 로드되지 않는다.
# 되돌리기: python Park3D/_UnusedContent/restore_unused.py
Park3D/_UnusedContent/

# ===== Visual Studio / OS 로컬 파일 =====
.vs/
*.VC.db
*.opendb
Thumbs.db
Desktop.ini

# ===== 기타 임시 파일 =====
*.tmp
*.log

# ===== 주차 시뮬레이션 주행 기록(실행 산출물) =====
# *.log 는 위에서 이미 제외됨. 리플레이용 프레임 json 도 실행마다 새로 생기므로 제외한다.
Park3D/Save/3D/Sim/
