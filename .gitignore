# ============================================================
# Park3D git 저장소 .gitignore
# - git 작업트리는 이 폴더(Parking), .git 메타데이터는 SVN 밖(D:\Work\GitRepos\Parking.git)
# - Content 등 대용량 바이너리는 SVN이 authoritative → git 제외
# ============================================================

# ===== Unreal Engine 생성물 (Park3D/) =====
Park3D/Binaries/
# 패키징(UAT BuildCookRun) 산출물 — 수 GB, SVN/재생성 대상
/Package/

# Python(_workspace 스크립트 등) 캐시
__pycache__/
*.pyc

# Node 의존성(park3d-rpc-mcp 브리지 등) — package.json 으로 재설치
node_modules/
Park3D/Intermediate/
Park3D/DerivedDataCache/
Park3D/Saved/
Park3D/.vs/
Park3D/*.sln
Park3D/*.slnx
Park3D/*.VC.db
Park3D/*.opensdf
Park3D/*.sdf

# ===== 대용량 바이너리 에셋 (SVN이 버전 관리) =====
# Content(.uasset/.umap)는 수 GB 바이너리 → git 제외. 에셋 이력은 SVN에서 관리.
Park3D/Content/

# ===== Visual Studio / OS 로컬 파일 =====
.vs/
*.VC.db
*.opendb
Thumbs.db
Desktop.ini

# ===== 기타 임시 파일 =====
*.tmp
*.log
